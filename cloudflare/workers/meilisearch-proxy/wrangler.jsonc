/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "meilisearch-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-11",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"MEILI_HOST": "https://search-origin.specialneeds.com",
		"MEILI_STANDBY_HOST": "https://search-standby.specialneeds.com"
	},
	"kv_namespaces": [
		{
			"binding": "FAILOVER_KV",
			"id": "c54f603f29f24d50b7b39ad5aa7e4ae8"
		}
	],
	"analytics_engine_datasets": [
		{
			"binding": "SEARCH_ANALYTICS",
			"dataset": "search_queries"
		}
	],
	"routes": [
		{
			"pattern": "search.specialneeds.com",
			"custom_domain": true
		}
	]
	// Note: Set MEILI_SEARCH_KEY as a secret with: wrangler secret put MEILI_SEARCH_KEY
}